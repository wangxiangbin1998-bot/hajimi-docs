<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>合伙人计划 · 哈吉米 API</title>
<meta name="description" content="哈吉米 API 合伙人计划：邀请好友用 API，注册奖 + 充值返佣自动到账，返佣最高 10%，每小时自动结算。">
<style>
  :root{
    --cream:#FFF6EC; --card:#FFFFFF; --main:#C05A33; --main-dark:#9A4525; --deep:#8A3B1E;
    --fill:#FBEEDD; --fill2:#FFF1DE;
    --ink:#3B2A20; --ink-soft:#7A6252; --line:#F0DFCE;
    --shadow:0 6px 24px rgba(192,90,51,.10), 0 1px 4px rgba(59,42,32,.05);
  }
  *{margin:0;padding:0;box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{background:var(--cream);color:var(--ink);
    font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Hiragino Sans GB","Microsoft YaHei","Noto Sans CJK SC",sans-serif;
    line-height:1.65;font-size:16px}
  a{color:var(--main);text-decoration:none}
  .wrap{max-width:1180px;margin:0 auto;padding:0 24px}
  section{scroll-margin-top:92px}

  /* ---------- 顶部主导航（不吸顶） ---------- */
  .topbar{border-bottom:1px solid var(--line)}
  .topbar-in{display:flex;align-items:center;justify-content:space-between;height:72px;gap:20px}
  .logo{font-size:20px;font-weight:900;color:var(--ink);white-space:nowrap}
  .logo em{font-style:normal;color:var(--main)}
  .top-links{display:flex;gap:30px}
  .top-links a{color:var(--ink);font-weight:600;font-size:15px}
  .top-links a:hover{color:var(--main)}
  .top-acts{display:flex;gap:10px;white-space:nowrap}
  .tbtn{display:inline-block;padding:9px 22px;border-radius:999px;font-weight:700;font-size:15px}
  .tbtn-ghost{background:#fff;color:var(--main);border:2px solid var(--main)}
  .tbtn-solid{background:var(--main);color:#fff}
  .tbtn-solid:hover{background:var(--main-dark)}

  /* ---------- 吸顶锚点导航 ---------- */
  .anchor-nav{position:sticky;top:0;z-index:60;padding:12px 0;background:rgba(255,246,236,.94);backdrop-filter:blur(8px)}
  .anchor-in{display:flex;gap:4px;background:#fff;border:1px solid var(--line);border-radius:999px;
    padding:6px;box-shadow:var(--shadow);overflow-x:auto;white-space:nowrap;scrollbar-width:none;-webkit-overflow-scrolling:touch}
  .anchor-in::-webkit-scrollbar{display:none}
  .anchor-in a{flex:1;text-align:center;color:var(--ink);font-weight:700;font-size:15px;
    padding:9px 18px;border-radius:999px;transition:.15s}
  .anchor-in a:hover{background:var(--main);color:#fff}
  .anchor-in a .ic{margin-right:6px}

  /* ---------- 通用 ---------- */
  .btn{display:inline-block;padding:14px 32px;border-radius:999px;font-weight:700;font-size:16px;transition:.15s;cursor:pointer}
  .btn-primary{background:var(--main);color:#fff;box-shadow:0 6px 18px rgba(192,90,51,.30)}
  .btn-primary:hover{background:var(--main-dark)}
  .btn-ghost{background:#fff;color:var(--main);border:2px solid var(--main)}
  .btn-ghost:hover{background:#FFF0E2}
  .eyebrow{font-size:13px;font-weight:800;letter-spacing:3px;text-transform:uppercase;color:var(--main)}
  section.blk{padding:56px 0 8px}
  .sec-head{text-align:center;max-width:720px;margin:0 auto 34px}
  .sec-head .no{font-size:14px;font-weight:900;color:var(--main);letter-spacing:2px}
  .sec-head .en{font-size:12px;font-weight:800;letter-spacing:3px;text-transform:uppercase;color:var(--ink-soft);margin-left:8px}
  .sec-head h2{font-size:32px;font-weight:900;margin:8px 0 10px}
  .sec-head p{color:var(--ink-soft);font-size:15px}
  .card{background:var(--card);border:1px solid #FBEBD9;border-radius:20px;box-shadow:var(--shadow);padding:28px}
  .money{color:var(--main);font-weight:800}
  .tagchip{display:inline-block;background:#FDEBD9;color:var(--main-dark);font-size:12px;font-weight:700;padding:3px 12px;border-radius:999px}
  details.bar{background:var(--card);border:1px solid #FBEBD9;border-radius:16px;box-shadow:var(--shadow)}
  details.bar>summary{cursor:pointer;list-style:none;font-weight:800;font-size:16px;padding:18px 24px}
  details.bar>summary::-webkit-details-marker{display:none}
  details.bar>summary::after{content:"＋";float:right;color:var(--main);font-weight:900}
  details.bar[open ]>summary::after{content:"－"}
  details.bar .bar-body{padding:0 24px 20px;color:var(--ink-soft);font-size:15px}
  details.bar .bar-body p{margin-bottom:10px}
  details.bar .bar-body p:last-child{margin-bottom:0}
  details.bar .bar-body b{color:var(--ink)}

  /* ---------- 英雄区 ---------- */
  .hero{display:grid;grid-template-columns:1.12fr .88fr;gap:44px;align-items:center;padding:58px 0 48px}
  .hero h1{font-size:42px;line-height:1.3;font-weight:900;margin:14px 0 16px}
  .hero h1 em{font-style:normal;color:var(--main)}
  .hero .sub{color:var(--ink-soft);font-size:17px;margin-bottom:30px;max-width:540px}
  .hero-btns{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:22px}
  .badges{display:flex;gap:10px;flex-wrap:wrap}
  .badge{background:#fff;border:1px solid var(--line);border-radius:999px;padding:6px 16px;font-size:13px;font-weight:700;color:var(--ink-soft);box-shadow:0 1px 3px rgba(59,42,32,.05)}
  .badge b{color:var(--main)}
  .data-card{background:#fff;border:1px solid #FBEBD9;border-radius:24px;box-shadow:var(--shadow);padding:30px 32px}
  .data-card .dc-head{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:10px}
  .data-card .dc-head h3{font-size:18px;font-weight:900}
  .data-card .dc-head span{font-size:11px;letter-spacing:2px;color:var(--ink-soft);font-weight:700}
  .dc-row{display:flex;justify-content:space-between;align-items:center;padding:16px 0;border-bottom:1px dashed var(--line)}
  .dc-row:last-of-type{border-bottom:none}
  .dc-row .k{color:var(--ink-soft);font-size:15px;font-weight:600}
  .dc-row .v{font-size:30px;font-weight:900;color:var(--main)}
  .dc-row .v small{font-size:15px;font-weight:700}
  .dc-foot{margin-top:12px;font-size:13px;color:var(--ink-soft);background:var(--fill);border-radius:10px;padding:10px 14px}

  /* ---------- 邀请码特权横幅 ---------- */
  .privilege{background:var(--fill);border:1px solid #F5D9B8;border-radius:20px;padding:26px 32px;
    display:flex;justify-content:space-between;align-items:center;gap:24px}
  .privilege h3{font-size:20px;font-weight:900;margin-bottom:4px}
  .privilege h3 .tagchip{vertical-align:3px;margin-left:8px}
  .privilege p{color:var(--ink-soft);font-size:15px}
  .privilege .big{font-size:56px;font-weight:900;color:var(--main);line-height:1;white-space:nowrap}

  /* ---------- 01 奖励制度 ---------- */
  .heavy-head{display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap;margin-bottom:8px}
  .heavy-head h3{font-size:21px;font-weight:900}
  .heavy-desc{color:var(--ink-soft);font-size:15px;margin-bottom:22px}
  .heavy-desc b{color:var(--ink)}
  .tier-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
  .tier-card{background:#fff;border:1px solid #FBEBD9;border-radius:18px;box-shadow:var(--shadow);padding:22px 18px;text-align:center}
  .tier-card .lv{font-weight:800;font-size:15px}
  .tier-card .pct{font-size:44px;font-weight:900;color:var(--main);line-height:1.15;margin:6px 0 2px}
  .tier-card .ex{font-size:13px;color:var(--ink-soft);min-height:40px}
  .tier-card .cond{border-top:1px solid var(--line);margin-top:12px;padding-top:12px;font-size:13px;font-weight:700;color:var(--ink)}
  .keep-rule{margin-top:16px;font-size:14px;color:var(--ink-soft);text-align:center}
  .duo{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:18px}
  .mini3{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:14px}
  .mini3 .m{background:var(--fill2);border-radius:14px;padding:14px 8px;text-align:center}
  .mini3 .m .mk{font-size:13px;color:var(--ink-soft);font-weight:700}
  .mini3 .m .mv{font-size:25px;font-weight:900;color:var(--main)}
  .total-line{margin-top:14px;border-top:1px solid var(--line);padding-top:12px;text-align:right;font-weight:800;font-size:15px}
  .total-line .money{font-size:19px}
  .note-line{margin-top:10px;font-size:13px;color:var(--ink-soft)}
  #rewards details.bar{margin-top:18px}

  /* ---------- 02 核心卖点 ---------- */
  .model-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
  .model-card{background:#fff;border:1px solid #FBEBD9;border-radius:18px;box-shadow:var(--shadow);padding:24px 22px}
  .model-card h3{font-size:18px;font-weight:900;margin-bottom:6px}
  .model-card p{font-size:14px;color:var(--ink-soft);min-height:66px}
  .model-card .rate{margin-top:10px;font-size:15px;color:var(--ink-soft)}
  .model-card .rate b{font-size:24px;color:var(--main);font-weight:900}
  .points-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:18px}
  .point-cell{background:#fff;border:1px solid #FBEBD9;border-radius:14px;padding:16px 18px;display:flex;gap:12px;align-items:flex-start}
  .point-cell .ic{font-size:20px;line-height:1.3}
  .point-cell h4{font-size:15px;font-weight:800}
  .point-cell p{font-size:13px;color:var(--ink-soft)}
  .fine-print{margin-top:16px;text-align:center;font-size:13px;color:var(--ink-soft)}

  /* ---------- 03 评论奖励 ---------- */
  .duo2{display:grid;grid-template-columns:1fr 1fr;gap:18px}
  .steps3{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:18px}
  .step-card{background:#fff;border:1px solid #FBEBD9;border-radius:18px;box-shadow:var(--shadow);padding:22px}
  .step-card .sn{display:inline-block;background:var(--main);color:#fff;font-size:12px;font-weight:800;border-radius:999px;padding:2px 12px;margin-bottom:10px}
  .step-card h4{font-size:16px;font-weight:900;margin-bottom:4px}
  .step-card p{font-size:14px;color:var(--ink-soft)}
  .guide3{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:18px}
  .jump-link{margin-top:22px;text-align:center;font-weight:800;font-size:16px}
  .jump-link a:hover{text-decoration:underline}

  /* ---------- 04 推广文案 ---------- */
  .model-grid-sm .model-card{padding:18px 20px}
  .model-grid-sm .model-card p{min-height:0}
  .tool-panel{margin-top:18px;background:linear-gradient(180deg,#FFF1DE,#FFE7CC);border:1px solid #F5D9B8;border-radius:24px;box-shadow:var(--shadow);padding:28px}
  .pills{display:flex;gap:10px;flex-wrap:wrap}
  .pill{border:2px solid #EBCB9F;background:#fff;color:var(--ink);border-radius:999px;padding:8px 20px;font-size:15px;font-weight:800;cursor:pointer;transition:.15s;font-family:inherit}
  .pill small{color:var(--ink-soft);font-weight:700;margin-left:4px}
  .pill.active{background:var(--main);border-color:var(--main);color:#fff}
  .pill.active small{color:#FFE1CF}
  .scene-tabs{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin-top:16px}
  .stab{background:#fff;border:2px solid #F0DFCE;border-radius:14px;padding:12px 14px;cursor:pointer;text-align:left;transition:.15s;font-family:inherit}
  .stab .n{font-size:12px;font-weight:900;color:var(--main)}
  .stab .t{display:block;font-size:15px;font-weight:800;color:var(--ink);margin:2px 0}
  .stab .s{font-size:12px;color:var(--ink-soft)}
  .stab.active{border-color:var(--main);background:#FFF9F1}
  .tpl-detail{background:#fff;border-radius:18px;border:1px solid #F3E3CB;margin-top:16px;padding:24px}
  .fld-label{font-weight:800;font-size:15px}
  .fld-hint{font-size:13px;color:var(--ink-soft);margin:2px 0 10px}
  .code-row{display:flex;gap:12px;flex-wrap:wrap}
  .code-row input{flex:1;min-width:220px;padding:12px 16px;border:2px solid #EBCB9F;border-radius:12px;font-size:16px;background:#fff;color:var(--ink);outline:none;font-family:inherit}
  .code-row input:focus{border-color:var(--main)}
  .gen-link{margin-top:10px;font-size:14px;color:var(--ink-soft);word-break:break-all}
  .gen-link code{color:var(--main-dark);font-weight:700}
  .tpl-meta{display:flex;justify-content:space-between;align-items:baseline;margin-top:22px;border-top:1px dashed var(--line);padding-top:16px}
  .tpl-count{font-size:13px;font-weight:900;color:var(--ink-soft);letter-spacing:2px}
  .tpl-title{font-size:17px;font-weight:900}
  .tpl-body{margin-top:10px;font-size:15.5px;color:var(--ink);overflow-wrap:anywhere}
  .tpl-body .lnk{color:var(--main-dark);font-weight:700;word-break:break-all}
  .tpl-foot{display:flex;justify-content:space-between;align-items:center;gap:14px;margin-top:18px;flex-wrap:wrap}
  .tpl-foot .hint{font-size:13px;color:var(--ink-soft)}
  .copy-btn{background:var(--main);color:#fff;border:none;border-radius:999px;padding:11px 26px;font-size:14px;font-weight:800;cursor:pointer;font-family:inherit;transition:.15s}
  .copy-btn:hover{background:var(--main-dark)}
  .copy-btn:disabled{background:#D9C4B2;cursor:not-allowed}
  .copy-btn.done{background:#4C9A52}

  /* ---------- 05 创作悬赏 ---------- */
  .board{background:var(--fill);border:1px solid #F5D9B8;border-radius:18px;padding:22px 26px;color:var(--ink-soft);font-size:15px}
  .board b{color:var(--ink)}
  .bounty-grid{display:grid;grid-template-columns:1fr 2fr;gap:18px;margin-top:18px}
  .bounty-bar{margin-top:18px;background:var(--fill);border:1px solid #F5D9B8;border-radius:18px;padding:22px 26px;
    display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap}
  .bounty-bar h3{font-size:19px;font-weight:900}
  .bounty-bar p{color:var(--ink-soft);font-size:14px}
  .bounty-bar .amt{font-size:17px;font-weight:900;color:var(--main);white-space:nowrap}
  .script-acc{margin-top:14px}
  details.bar .sum-flex{display:flex;justify-content:space-between;align-items:center;gap:16px}
  details.bar .sum-left{display:flex;gap:16px;align-items:center}
  details.bar .sno{font-size:22px;font-weight:900;color:var(--main)}
  details.bar .stt{font-size:17px;font-weight:900}
  details.bar .ssub{font-size:13px;color:var(--ink-soft);font-weight:600}
  details.bar .view{flex:none;background:#FDEBD9;color:var(--main-dark);font-size:13px;font-weight:800;border-radius:999px;padding:6px 16px}
  details.bar[open ] .view{background:var(--main);color:#fff}
  details.bar summary.no-plus::after{content:""}
  .script-cols{display:grid;grid-template-columns:1fr 1fr;gap:26px}
  .script-cols h5{font-size:14px;font-weight:900;color:var(--main-dark);margin-bottom:8px;letter-spacing:1px}
  .script-cols ol{margin-left:20px;font-size:14.5px}
  .script-cols ol li{margin-bottom:4px}
  .script-cols .tt{font-size:14.5px;margin-bottom:4px}
  .tpl-box{background:var(--fill2);border-radius:12px;padding:14px 16px;font-size:14.5px;color:var(--ink);overflow-wrap:anywhere}
  .script-copy-row{margin-top:14px;text-align:right}

  /* ---------- 06 参与指引 ---------- */
  .guide-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
  .guide-card{background:#fff;border:1px solid #FBEBD9;border-radius:18px;box-shadow:var(--shadow);padding:26px}
  .guide-card .gn{font-size:30px;font-weight:900;color:var(--main);line-height:1}
  .guide-card h3{font-size:17px;font-weight:900;margin:10px 0 6px}
  .guide-card p{font-size:14.5px;color:var(--ink-soft)}
  .dark-banner{margin-top:20px;border-radius:24px;padding:36px 40px;color:#FFF3E4;
    background:linear-gradient(135deg,#8A3B1E,#6E2C14);display:flex;justify-content:space-between;align-items:center;gap:26px;flex-wrap:wrap;
    box-shadow:0 10px 30px rgba(138,59,30,.30)}
  .dark-banner h3{font-size:23px;font-weight:900;margin-bottom:6px}
  .dark-banner p{color:#F3D9C6;font-size:15px;max-width:560px}
  .dark-banner .big{font-size:42px;font-weight:900;color:#FFC98F;white-space:nowrap}

  /* ---------- 07 FAQ / CTA / 页脚 ---------- */
  .faq-list{max-width:860px;margin:0 auto;display:grid;gap:12px}
  .cta{text-align:center;padding:70px 0 60px}
  .cta h2{font-size:32px;font-weight:900;margin-bottom:10px}
  .cta p{color:var(--ink-soft);margin-bottom:26px}
  footer{border-top:1px solid var(--line);margin-top:10px}
  .foot-top{display:flex;justify-content:space-between;align-items:flex-start;gap:20px;padding:28px 0 20px;flex-wrap:wrap}
  .foot-top .slogan{color:var(--ink-soft);font-size:14px;margin-top:4px}
  .foot-links{display:flex;gap:24px;flex-wrap:wrap}
  .foot-links a{color:var(--ink);font-weight:600;font-size:14.5px}
  .foot-links a:hover{color:var(--main)}
  .foot-bottom{border-top:1px solid var(--line);padding:16px 0 26px;display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap;
    color:var(--ink-soft);font-size:13px}

  .toast{position:fixed;left:50%;bottom:34px;transform:translateX(-50%) translateY(20px);background:var(--ink);color:#fff;
    padding:10px 22px;border-radius:999px;font-size:14px;opacity:0;pointer-events:none;transition:.25s;z-index:99}
  .toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

  @media (max-width:1020px){
    .hero{grid-template-columns:1fr;gap:28px}
    .tier-grid,.model-grid{grid-template-columns:1fr 1fr}
    .scene-tabs{grid-template-columns:repeat(3,1fr)}
    .points-grid{grid-template-columns:1fr 1fr}
  }
  @media (max-width:680px){
    .wrap{padding:0 16px}
    .top-links{display:none}
    .hero{padding:38px 0 34px}
    .hero h1{font-size:30px}
    .tier-grid,.model-grid,.duo,.duo2,.steps3,.guide3,.guide-grid,.bounty-grid,.script-cols{grid-template-columns:1fr}
    .points-grid{grid-template-columns:1fr}
    .scene-tabs{grid-template-columns:1fr 1fr}
    .privilege{flex-direction:column;align-items:flex-start}
    .privilege .big{font-size:44px}
    .dark-banner{padding:28px 24px}
    .dark-banner .big{font-size:32px}
    .tool-panel{padding:20px 16px}
    .sec-head h2{font-size:26px}
    .anchor-in a{padding:9px 14px;font-size:14px}
    .topbar-in{height:62px}
    .tbtn{padding:8px 16px;font-size:14px}
  }
</style>
</head>
<body>

<!-- 顶部主导航 -->
<div class="topbar">
  <div class="wrap topbar-in">
    <div class="logo">🐾 哈吉米 <em>API</em></div>
    <nav class="top-links">
      <a href="https://hajimi.men">主站</a>
      <a href="https://docs.hajimi.men">文档</a>
      <a href="https://hajimi.men/pricing">定价</a>
      <a href="https://qm.qq.com/q/m6gVsCbSHQ">官方 QQ 群</a>
    </nav>
    <div class="top-acts">
      <a class="tbtn tbtn-ghost" href="https://hajimi.men/login">登录</a>
      <a class="tbtn tbtn-solid" href="https://hajimi.men/register">开始使用</a>
    </div>
  </div>
</div>

<!-- 吸顶锚点导航 -->
<nav class="anchor-nav">
  <div class="wrap">
    <div class="anchor-in">
      <a href="#rewards"><span class="ic">🎁</span>奖励制度</a>
      <a href="#points"><span class="ic">⭐</span>核心卖点</a>
      <a href="#comments"><span class="ic">💬</span>评论奖励</a>
      <a href="#promote"><span class="ic">✍️</span>推广文案</a>
      <a href="#bounty"><span class="ic">🏆</span>创作悬赏</a>
      <a href="#guide"><span class="ic">🧭</span>参与指引</a>
    </div>
  </div>
</nav>

<div class="wrap">

  <!-- 英雄区 -->
  <div class="hero">
    <div>
      <div class="eyebrow">Partner Program</div>
      <h1>邀请好友用 API，<em>返佣自动到账</em></h1>
      <p class="sub">把你的邀请链接分享给需要用 AI 的朋友：他注册你得奖励，他充值你拿百分比返佣，每小时自动结算到账，不用记账、不用催账。</p>
      <div class="hero-btns">
        <a class="btn btn-primary" href="#promote">拿到我的邀请链接</a>
        <a class="btn btn-ghost" href="#rewards">查看奖励制度</a>
      </div>
